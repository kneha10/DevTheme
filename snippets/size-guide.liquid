{% if template contains 'product' %}
  <div class="size-chart-container">
    <span class="size-chart-btn">Size Chart</span>
    <div class="size-chart-modal">
      <div class="modal-content">
        <span class="close-btn">&times;</span>
        <img class="size-chart-image" src="{{ product.metafields.custom.size_guide | image_url }}" alt="Size Chart">  
     </div>
    </div>
  </div>
{% endif %}

<style>
  /* Add this CSS to your theme's stylesheet */

  .size-chart-container {
    position: relative;
    display: inline-block;
    margin-bottom: 10px;
    top: 4px;
  }

  .size-chart-btn {
    text-decoration: underline;
    cursor: pointer;
  }

  .size-chart-modal {
    display: none; /* Initially hide the modal */
    position: fixed;
    z-index: 99999999999999999; /* Ensure the modal is on top of other content */
    left: 0;
    top: 37px;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.4);
  }

  .modal-content {
    background-color: #fff;
    padding: 20px;
    border: 1px solid #ccc;
    border-radius: 5px;
    width: 70%;
    /* margin: 20px auto; */
    max-width: 600px;
    margin: 70px auto;
}
  
  }

  .close-btn {
    color: #fff;
    background-color: #4caf50;
    font-size: 18px;
    font-weight: bold;
    position: absolute;
    top: 60px;
    right: 360px;
    width: 25px;
    height: 25px;
    text-align: center;
    line-height: 25px;
    cursor: pointer;
    border: none;
    border-radius: 50%;
    z-index: 10000; /* Ensure the close button is above the modal content */
  }

  .close-btn:hover,
  .close-btn:focus {
    background-color: #3e8e41;
  }

  .size-chart-image {
    max-width: 100%;
    display: block;
    margin: 0 auto;
  }
</style>


<script>
document.addEventListener("DOMContentLoaded", function() {
  const sizeChartBtn = document.querySelector(".size-chart-btn");
  const sizeChartModal = document.querySelector(".size-chart-modal");
  const closeBtn = document.querySelector(".close-btn");

  sizeChartBtn.addEventListener("click", function() {
    sizeChartModal.style.display = "block";
    document.body.style.overflow = "hidden"; // Disable scrolling
  });

  closeBtn.addEventListener("click", function() {
    sizeChartModal.style.display = "none";
    document.body.style.overflow = "auto"; // Enable scrolling
  });

  // Close the modal if user clicks outside of it
  window.addEventListener("click", function(event) {
    if (event.target === sizeChartModal) {
      sizeChartModal.style.display = "none";
      document.body.style.overflow = "auto"; // Enable scrolling
    }
  });
});
</script>

