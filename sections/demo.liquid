<style>
        /* Custom styles */
        .slick-slider {
            width: 80%;
            margin: 0 auto;
        }

        .slick-slide img {
            display: block;
            margin: 0 auto;
        }

        .slick-dots {
            bottom: 10px;
        }
    </style>


