{{ "section-faq.css" | asset_url | stylesheet_tag  }}

{% comment %} This is dynamic {% endcomment %}

<div class="page-width faq">
  <h2 class="faq-heading">{{ section.settings.headline }}</h2>

  {% for block in section.blocks %}
     <div class="faq_row">
        <input type="checkbox" id="question-{{ forloop.index }}" class="faq_toggle"></input>
        <label for="question-{{ forloop.index }}" class="faq_question">{{ block.settings.question }}</label>
        <div class="faq_answer">{{ block.settings.answer }}</div>
     </div>
  {% endfor %}

</div>


