<div class="pincode-checker" style="max-width:400px; margin:1em auto;">
  <form id="pincode-checker-form" style="display:flex;border:1px solid #ddd;border-radius:4px;overflow:hidden;">
    <input
      id="pincode-input"
      type="text"
      placeholder="Enter pincode to view serviceability"
      style="flex:1;border:none;padding:0.75em;font-size:1em;"
      required
    />
    <button
      type="submit"
      style="background:none;border:none;padding:0 1em;color:#5f2eea;cursor:pointer;font-size:1em;"
    >Check</button>
  </form>
  <p id="pincode-result" style="margin-top:0.5em;font-weight:500;"></p>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function(){
    const form   = document.getElementById('pincode-checker-form');
    const input  = document.getElementById('pincode-input');
    const result = document.getElementById('pincode-result');
    const pincodes = window.PINCODE_LIST || [];

    form.addEventListener('submit', function(e){
      e.preventDefault();
      const pin = input.value.trim();
      if (!pin) return;
      if (pincodes.includes(pin)) {
        result.textContent = '✔️ Good news! We deliver to your area.';
        result.style.color = 'green';
      } else {
        result.textContent = '❌ Sorry, we do not yet deliver to this pincode.';
        result.style.color = 'red';
      }
    });
  });
</script>


{% schema %}
{
  "name": "Pincode Checker",
  "settings": [],
  "presets": [
    {
      "name": "Pincode checker"
    }
  ]
}
{% endschema %}
